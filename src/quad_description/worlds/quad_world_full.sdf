<?xml version="1.0"?>
<sdf version="1.9">
  <world name="quad_world">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient></material>
        </visual>
      </link>
    </model>

    <model name="quadrotor">
      <pose>0 0 1 0 0 0</pose>
      <link name="base_link">
        <gravity>false</gravity>  <!-- no flight controller, so we cancel gravity -->
        <inertial>
          <mass>1.5</mass>
          <inertia><ixx>0.03</ixx><iyy>0.03</iyy><izz>0.06</izz>
                    <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>

        <!-- central hub -->
        <visual name="hub_visual">
          <geometry><box><size>0.18 0.18 0.08</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>

        <!-- 4 arms, X configuration -->
        <visual name="arm_fl">
          <pose>0.15 0.15 0 0 1.5708 0.7854</pose>
          <geometry><cylinder><radius>0.015</radius><length>0.32</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <visual name="arm_fr">
          <pose>0.15 -0.15 0 0 1.5708 -0.7854</pose>
          <geometry><cylinder><radius>0.015</radius><length>0.32</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <visual name="arm_bl">
          <pose>-0.15 0.15 0 0 1.5708 -0.7854</pose>
          <geometry><cylinder><radius>0.015</radius><length>0.32</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>
        <visual name="arm_br">
          <pose>-0.15 -0.15 0 0 1.5708 0.7854</pose>
          <geometry><cylinder><radius>0.015</radius><length>0.32</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>

        <!-- 4 rotor motors (small dark cylinders at arm tips) -->
        <visual name="motor_fl">
          <pose>0.26 0.26 0.02 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
        <visual name="motor_fr">
          <pose>0.26 -0.26 0.02 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
        <visual name="motor_bl">
          <pose>-0.26 0.26 0.02 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
        <visual name="motor_br">
          <pose>-0.26 -0.26 0.02 0 0 0</pose>
          <geometry><cylinder><radius>0.03</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>

        <!-- 4 propeller discs (flat, semi-transparent) -->
        <visual name="prop_fl">
          <pose>0.26 0.26 0.045 0 0 0</pose>
          <geometry><cylinder><radius>0.13</radius><length>0.006</length></cylinder></geometry>
          <material><ambient>0.6 0.6 0.6 0.5</ambient><diffuse>0.6 0.6 0.6 0.5</diffuse></material>
        </visual>
        <visual name="prop_fr">
          <pose>0.26 -0.26 0.045 0 0 0</pose>
          <geometry><cylinder><radius>0.13</radius><length>0.006</length></cylinder></geometry>
          <material><ambient>0.6 0.6 0.6 0.5</ambient><diffuse>0.6 0.6 0.6 0.5</diffuse></material>
        </visual>
        <visual name="prop_bl">
          <pose>-0.26 0.26 0.045 0 0 0</pose>
          <geometry><cylinder><radius>0.13</radius><length>0.006</length></cylinder></geometry>
          <material><ambient>0.6 0.6 0.6 0.5</ambient><diffuse>0.6 0.6 0.6 0.5</diffuse></material>
        </visual>
        <visual name="prop_br">
          <pose>-0.26 -0.26 0.045 0 0 0</pose>
          <geometry><cylinder><radius>0.13</radius><length>0.006</length></cylinder></geometry>
          <material><ambient>0.6 0.6 0.6 0.5</ambient><diffuse>0.6 0.6 0.6 0.5</diffuse></material>
        </visual>

        <!-- single collision box, physics doesn't need to match visuals -->
        <collision name="body_collision">
          <geometry><box><size>0.55 0.55 0.15</size></box></geometry>
        </collision>
      </link>

      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <topic>/model/quadrotor/cmd_vel</topic>
      </plugin>

      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_frame>odom</odom_frame>
        <robot_base_frame>base_link</robot_base_frame>
        <odom_topic>/model/quadrotor/odometry</odom_topic>
        <odom_publish_frequency>30</odom_publish_frequency>
        <dimensions>3</dimensions>
      </plugin>
    </model>
  </world>
</sdf>
